# Auto detect text files and perform LF normalization
* text=auto

# Keep source files LF so gofmt/git diffs are stable across platforms;
# Windows batch files stay CRLF.
*.go   text eol=lf
*.py   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.bat  text eol=crlf
